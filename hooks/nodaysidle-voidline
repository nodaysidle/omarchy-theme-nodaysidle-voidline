#!/bin/bash
# Omarchy Theme Hook for nodaysidle Voidline
set -euo pipefail

THEME="${1:-}"

if [[ "$THEME" == "nodaysidle-voidline" || "$THEME" == "Nodaysidle Voidline" ]]; then
  # Reload Ghostty if running
  killall -SIGUSR2 ghostty >/dev/null 2>&1 || true
  echo "[nodaysidle-voidline] Applied theme hook and notified Ghostty"
fi
